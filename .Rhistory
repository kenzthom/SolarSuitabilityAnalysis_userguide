utility_gen <- sf::st_read("~/Library/CloudStorage/OneDrive-UBC/RA/SolarModel_Guide/data/energy/top_energy_above100MW_outsideMuni.shp")
comm_gen_energy <- process_solar_sites(comm_gen, pvout_mask)
utility_gen_energy <- process_solar_sites(utility_gen, pvout_mask)
View(utility_gen_energy)
cap_comm_gen <- sum(com_gen_energy$Ci, na.rm = TRUE) / 1000000
Total Capacity: convert kW to GigaWatts (GW) for utility scale
# Total Capacity: convert kW to GigaWatts (GW) for utility scale
cap_comm_gen <- sum(comm_gen_energy$Ci, na.rm = TRUE) / 1000000
cap_utility_gen <- sum(utility_gen_energy$Ci, na.rm = TRUE) / 1000000
# Total Annual Energy: convert kWh to Terawatt-hours (TWh/year)
energy_comm_gen <- sum(comm_gen_energy$Ei, na.rm = TRUE) / 1000000000
energy_utility_gen <- sum(utility_gen_energy$Ei, na.rm = TRUE) / 1000000000
# Print final utility reports
cat("--- Community Generation (2MW within Municipalities) Results ---\n",
"Total Capacity:", round(cap_comm_gen, 2), "GW \n",
"Annual Yield  :", round(energy_comm_gen, 2), "TWh/year \n\n")
cat("--- Utility Generation (100MW outside Municipalities) Results ---\n",
"Total Capacity:", round(cap_utility_gen, 2), "GW \n",
"Annual Yield  :", round(energy_utility_gen, 2), "TWh/year \n")
cat("--- Community Generation (2MW within Municipalities) Results ---\n",
"Total Capacity:", round(cap_comm_gen, 2), "GW \n",
"Annual Yield  :", round(energy_comm_gen, 2), "TWh/year \n\n")
cat("--- Utility Generation (100MW outside Municipalities) Results ---\n",
"Total Capacity:", round(cap_utility_gen, 2), "GW \n",
"Annual Yield  :", round(energy_utility_gen, 2), "TWh/year \n")
