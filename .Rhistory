str_trim())
# Calculate the scaling factor to have double y axis
scale_factor <- max(RegDis_energy_df$total_capacity_GW, na.rm = TRUE) / max(RegDis_energy_df$total_energy_TWh, na.rm = TRUE)
ggplot(RegDis_energy_df, aes(x = reorder(Reg_Dis, total_energy_TWh))) +
ggtitle("Resource Yield by Regional District") +
# Capacity bars (Primary Y-axis)
geom_col(aes(y = total_capacity_GW, fill = "Capacity (GW)"),
position = position_nudge(x = -0.15), width = 0.3) +
# Energy bars (Scaled up to match the primary Y-axis)
geom_col(aes(y = total_energy_TWh * scale_factor, fill = "Energy (TWh)"),
position = position_nudge(x = 0.15), width = 0.3) +
# Setup the primary and secondary axes
scale_y_continuous(
name = "Installable Capacity (GW)",
sec.axis = sec_axis(~ . / scale_factor, name = "Annual Energy (TWh)")) +
# Labels and Theme
labs(x = "Regional District",
fill = "Resource") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
plot.title = element_text(face = "bold"),
legend.position = "bottom",
panel.grid.major.x = element_blank()) +
theme(text = element_text(family = "Times"))
View(RegDis_energy_df)
