ggplot(RegDis_energy_df, aes(x = reorder(Reg_Dis, total_energy_TWh), y = total_energy_TWh)) +
geom_col(aes(fill = total_capacity_GW)) +
facet_wrap(~tier, scales = "free_x") +
scale_fill_gradient(name = "Capacity (GW)", low = "#FFFFCC",high = "#BD0026") +
coord_flip() +
labs(title = "Annual Energy Yield by Regional District",
