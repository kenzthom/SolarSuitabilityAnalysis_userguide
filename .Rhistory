summarise(total_capacity_GW = sum(Ci)/1000000,
total_energy_TWh = sum(Ei)/1000000000,
suitable_area_km2 = sum(Area_km2)) %>%
rename(Reg_Dis = AA_NAME) %>%
arrange(total_energy_TWh)
