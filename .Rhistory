RegDis_energy_df <- read.csv("/Users/kenziethomson/Library/CloudStorage/OneDrive-UBC/RA/SolarModel_Guide/data/energy/RegDis_energy_summary.csv")
RegDis_energy_df <- RegDis_energy_df %>%
