# Visualize data distribution
ggplot(all_ahp, aes(x = reorder(Criteria, Weight, FUN = mean), y = Weight)) +
  geom_boxplot(outlier.shape = NA) +
  geom_point(aes(color = Name, shape = Sector), size = 2) +
  theme_minimal() +
  labs(
    title = "Distribution of AHP Weights by Experts",
       x = "Suitability Criteria",
       y = "Weight (%)") +
  scale_shape_manual(
    values = c(16, 17, 18), # 16 = circle , 17 = triangle, 18 = diamond
    name = "Sector",
    labels = c("Academia", "Industry", "Policy")) +
  scale_color_viridis_d(option = "turbo", name = "Expert Name")

# Option 2: Add marker of final weights
final_weights <- data.frame(
  Criteria = c("GTI", "Slope", "Aspect", "Prox to Cities", 
               "Prox to Roads", "Prox to Subs"),
  Weight = c(26.275243, 9.270032, 8.552311, 
             11.224992, 14.434327, 30.243095))

ggplot(all_ahp, aes(x = reorder(Criteria, Weight, FUN = median), y = Weight)) +
  geom_boxplot(outlier.shape = NA) +
  geom_point(aes(color = Name, shape = Sector), size = 2) +
  geom_point(data = final_weights, 
             aes(x = Criteria, y = Weight, fill = "Geometric-mean"),
             shape = 8, size = 3.5, color = "black", inherit.aes = FALSE) +
  theme_minimal() +
  labs(title = "Distribution of Individual AHP Weights vs. Aggregated Group Weight",
       x = "Suitability Criteria", y = "Weight (%)") +
  scale_shape_manual(values = c(16, 17, 18), name = "Sector") +
  scale_fill_manual(values = c("Geometric-mean" = "black"), name = "Weight Type") +
  scale_color_viridis_d(option = "turbo", name = "Expert Name")

