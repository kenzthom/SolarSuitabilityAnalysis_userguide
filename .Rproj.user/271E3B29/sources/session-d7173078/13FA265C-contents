# Read in NEW reg dis layer
new_rd <- sf::st_read("/Users/kenziethomson/Downloads/BCGW_02001F02_1786636556678_10892/ABMS_REGIONAL_DISTRICTS_SP/ABMS_RD_polygon.shp")
plot(st_geometry(new_rd))

# Check if geometry is invalid
st_is_valid(new_rd)  # checking before assigning to new_rd_fixed

# Repair invalid geometries
new_rd_fixed <- st_make_valid(new_rd)
st_is_valid(new_rd_fixed) 

# Intersect with old rd to remove marine area
bc_union <- sf::st_union(bc) 
reg_dis <- sf::st_intersection(new_rd_fixed, bc_union)

# Join northern rockies back to new RD 
reg_dis_new <- rbind(reg_dis %>% 
                       select(AA_NAME, geometry), bc %>% 
                       filter(NAME_2 == "Northern Rockies") %>% 
                       select(geometry) %>%
                       mutate(AA_NAME = "Northern Rockies"))

# Export
sf::st_write(reg_dis_new, "/Users/kenziethomson/Library/CloudStorage/OneDrive-UBC/RA/Data/Admin Boundaries/RegionalDistricts_Updated.shp")
reg_dis_new <- sf::st_read("/Users/kenziethomson/Library/CloudStorage/OneDrive-UBC/RA/Data/Admin Boundaries/RegionalDistricts_Updated.shp")

