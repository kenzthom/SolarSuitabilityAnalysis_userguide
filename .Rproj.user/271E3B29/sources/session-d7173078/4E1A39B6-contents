top_energy_2MW_withinMuni <- sf::st_read("/Users/kenziethomson/Library/CloudStorage/OneDrive-UBC/RA/SolarModel_Guide/data/energy/top_energy_under2MW_withinMuni.shp") 

# Print Report 

# Total Capacity: convert kW to GigaWatts (GW) for utility scale
class4_2MW_total_cap_GW <- sum(top_energy_2MW_withinMuni$Ci, na.rm = TRUE) / 1000000
class5_2MW_total_cap_GW <- sum(top_energy_2MW_withinMuni$Ci, na.rm = TRUE) / 1000000

# Total Annual Energy: convert kWh to Terawatt-hours (TWh/year)
class4_2MW_total_eng_TWh <- sum(top_energy_2MW_withinMuni$Ei, na.rm = TRUE) / 1000000000
class5_2MW_total_eng_TWh <- sum(top_energy_2MW_withinMuni$Ei, na.rm = TRUE) / 1000000000

# Print final utility reports 
cat("--- CLASS 4 RESULTS ---\n",
    "Total Capacity:", round(class4_2MW_total_cap_GW, 2), "GW \n",
    "Annual Yield  :", round(class4_2MW_total_eng_TWh, 2), "TWh/year \n\n")

cat("--- CLASS 5 RESULTS ---\n",
    "Total Capacity:", round(class5_2MW_total_cap_GW, 2), "GW \n",
    "Annual Yield  :", round(class5_2MW_total_eng_TWh, 2), "TWh/year \n")

# What muniicpality has the greatest potential? 

RegDis_energy_2MW <- top_energy_2MW_withinMuni %>%
  filter(!is.na(AA_NAME)) %>%  # Drop the NA slivers
  group_by(AA_NAME) %>%
  summarise(total_capacity_GW = sum(Ci)/1000000,
            total_energy_TWh = sum(Ei)/1000000000,
            suitable_area_km2 = sum(Area_km2)) %>%
  rename(Reg_Dis = AA_NAME) %>%
  arrange(total_energy_TWh)

