# 3. Regional district breakdown ----

# Read in regional districts data 
rd <- sf::st_read( "/Users/kenziethomson/Library/CloudStorage/OneDrive-UBC/RA/Data/Admin Boundaries/NorthernBC_RegionalDistricts.shp")

# Project to 3005
rd <- sf::st_transform(rd, crs = 3005)

# Count of suitability per Reg Dis using a for loop to overcome memory issues

# Define classes of interest
suit_classes <- 0:5

# Ensure reg dis is a spatvect with match crs
rd_v <- vect(rd)
rd_v <- project(rd_v, crs(nbc_suit))

# Create empty list to store results 
zonalStats <- list()

# Initiate loop 
for (i in 1:nrow(rd_v)) {
  message(paste("Processing district:", i, "of", nrow(rd_v)))
  
  single_dis <- rd_v[i, ]
  
  nbc_crop <- crop(nbc_suit, single_dis)
  nbc_mask <- mask(nbc_crop, single_dis)
  rm(nbc_crop)
  gc()
  
  # --- chunked reading so values() never blows up RAM ---
  bs <- blocks(nbc_mask, n = 50)  # 50 horizontal strips
  counts_vec <- setNames(numeric(length(suit_classes)), as.character(suit_classes))
  
  for (b in 1:bs$n) {
    chunk <- values(
      nbc_mask,
      row   = bs$row[b],
      nrows = bs$nrows[b],
      na.rm = FALSE          # keep NAs so indexing stays correct
    )
    chunk <- chunk[!is.na(chunk)]   # drop NA/masked cells
    
    for (cls in suit_classes) {
      counts_vec[as.character(cls)] <- counts_vec[as.character(cls)] + sum(chunk == cls)
    }
    
    rm(chunk)
  }
  
  rm(nbc_mask)
  gc()
  
  zonalStats[[i]] <- tibble(
    district_id   = i,
    district_name = rd_v$AA_NAME[i],  
    class         = suit_classes,
    cell_count    = as.numeric(counts_vec)
  )
}

# Create proportions
zonalstats_df <- bind_rows(zonalStats) %>%
  group_by(district_id, district_name) %>%
  mutate(
    total_cells = sum(cell_count, na.rm = TRUE),
    proportion  = if_else(total_cells > 0, cell_count / total_cells, 0)) %>%
  ungroup() %>%
  mutate(class = factor(class,
                        levels = suit_classes,
                        labels = paste("Class", suit_classes)))

# Add area column using cell res * count
pixel_area_km2 <- prod(res(nbc_suit)) / 1e6 
zonalstats_df$Area_km2 <- round(zonalstats_df$cell_count * pixel_area_km2, 2)

# Organize so they are sorted in descending order from most suitable to least suitable
class5_order <- zonalstats_df %>%
  filter(class == "Class 5") %>%
  arrange(Area_km2) %>%
  pull(district_name)

zonalstats_df <- zonalstats_df %>%
  mutate(district_name = factor(as.character(district_name), levels = class5_order))

write.csv(zonalstats_df, "/Users/kenziethomson/Library/CloudStorage/OneDrive-UBC/RA/Data/Existing Renewables Mapping Project/Northern BC Solar Suitability/regdis_table_v4.csv",
          row.names = FALSE)

# Visualize
class_colors <- c(
  "Class 0" = "#696969",
  "Class 1" = "#FFFFCC",      
  "Class 2" = "#FECC5C",     
  "Class 3" = "#FD8D3C",     
  "Class 4" = "#F03B20",      
  "Class 5" = "#BD0026") 

# Visualize breakdown using raw area (not peudo log scale) 
# Accurate depiction but hard to infer anything because total area between each 
ggplot(zonalstats_df, aes(fill = class, y = Area_km2, x = district_name)) +
  geom_bar(position = "stack", stat = "identity") +
  ggtitle("Suitability by Regional District") +
  scale_fill_manual(
    values = class_colors, 
    name = "Suitability Class",
    labels = c("Class 0" = "Restricted",
               "Class 1" = "Least Suitable",
               "Class 2" = "Less Suitable",
               "Class 3" = "Moderately Suitable",
               "Class 4" = "Suitable",
               "Class 5" = "Very Suitable")) +
  labs(x = "Regional District", 
       y = expression("Area (km"^2*")"), 
       fill = "Suitability Class") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
  theme(panel.grid.major.x = element_blank(),
        panel.grid.minor.y = element_blank(),
        legend.position = "bottom",
        plot.title = element_text(face = "bold"))


