# 1. Create df of suitability results ----

# Read in suitability map clipped to northern BC 
nbc_suit <- rast("/Users/kenziethomson/Library/CloudStorage/OneDrive-UBC/RA/Data/Existing Renewables Mapping Project/Northern BC Solar Suitability/suitability_masked_v4_NortherBC.tif")

# Get map data as a df
nbc_sum <- as.data.frame(freq(nbc_suit))

