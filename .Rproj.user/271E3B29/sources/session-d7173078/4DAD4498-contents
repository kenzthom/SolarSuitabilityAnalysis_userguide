### Step 3: Regional District breakdown

```{r}
# Regional district breakdown

# Read in regional districts data 
nbc_rd <- sf::st_read("/Users/kenziethomson/Library/CloudStorage/OneDrive-UBC/RA/Data/Admin Boundaries/NorthernBC_RegionalDistricts.shp")

# Project to 3005
nbc_rd <- sf::st_transform(nbc_rd, crs = 3005)

# Count of suitability per Reg Dis using a for loop to overcome memory issues

# Define classes of interest
suit_classes <- 0:5

# Ensure reg dis is a spatvect with match crs
nbc_rd_v <- vect(nbc_rd)
nbc_rd_v <- project(nbc_rd_v, crs(nbc_suit))

# Create empty list to store results 
nbc_zonalStats <- list()

# Initiate loop 
for (i in 1:nrow(nbc_rd_v)) {
  message(paste("Processing district:", i, "of", nrow(nbc_rd_v)))
  
  single_dis <- nbc_rd_v[i, ]
  
  # Crop and mask to the individual district
  nbc_suitability_crop <- crop(nbc_suit, single_dis)
  nbc_suitability_mask <- mask(nbc_suitability_crop, single_dis)
  rm(nbc_suitability_crop)
  
  # Extract all values from the cropped district directly 
  vals <- values(nbc_suitability_mask, mat = FALSE, na.rm = TRUE)
  
  # Count the frequencies of your target classes
  counts_vec <- sapply(suit_classes, function(cls) sum(vals == cls))
  
  rm(nbc_suitability_mask)
  gc()
  
  nbc_zonalStats[[i]] <- tibble(
    district_id   = i,
    district_name = nbc_rd_v$AA_NAME[i],  
    class         = suit_classes,
    cell_count    = as.numeric(counts_vec)
  )
}

pixel_area_km2 <- prod(res(nbc_suit)) / 1e6

nbc_zonalstats_df <- bind_rows(nbc_zonalStats) %>%
  # Clean names using case_when
  mutate(
    district_name = case_when(
      str_detect(district_name, regex("bulkley-nechako", ignore_case = TRUE)) ~ "Bulkley-Nechaco",
      str_detect(district_name, regex("cariboo", ignore_case = TRUE)) ~ "Cariboo",
      str_detect(district_name, regex("Fraser-Fort George", ignore_case = TRUE)) ~ "Fraser-Fort George",
      str_detect(district_name, regex("Kitimat-Stikine", ignore_case = TRUE)) ~ "Kitimat-Stikine",
      str_detect(district_name, regex("Peace River", ignore_case = TRUE)) ~ "Peace River",
      str_detect(district_name, regex("Central Coast", ignore_case = TRUE)) ~ "Central Coast",
      str_detect(district_name, regex("Stikine", ignore_case = TRUE)) ~ "Stikine",
      str_detect(district_name, regex("North Coast", ignore_case = TRUE)) ~ "North Coast",
      str_detect(district_name, regex("Northern Rockies", ignore_case = TRUE)) ~ "Northern Rockies")) %>%
  group_by(district_id, district_name) %>%
  mutate(
    total_cells = sum(cell_count, na.rm = TRUE),
    proportion = if_else(total_cells > 0, cell_count / total_cells, 0),
    class = factor(class, levels = suit_classes, labels = paste("Class", suit_classes)),
    area_km2 = round(cell_count * pixel_area_km2, 2)) 

# Reorder districts by Class 4 + Class 5 area
nbc_class_order <- nbc_zonalstats_df %>%
  filter(class %in% c("Class 4", "Class 5")) %>%
  group_by(district_name) %>%
  summarize(total = sum(area_km2, na.rm = TRUE)) %>%
  arrange(total) %>%
  pull(district_name)

nbc_zonalstats_df$district_name <- factor(nbc_zonalstats_df$district_name, levels = nbc_class_order)
```

